# LLM provider selection (CLI --provider / --model override these)
LLM_PROVIDER="ollama"          # ollama | ollama-cloud | openai
LLM_MODEL=""                    # e.g. qwen2.5:7b, llama3.1:8b, gpt-4o-mini

# Local Ollama daemon
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama Cloud (only for --provider ollama-cloud)
OLLAMA_CLOUD_API_KEY=""

# OpenAI (only for --provider openai)
OPENAI_API_KEY=""
